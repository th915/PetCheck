### 1. 고객 가입
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "receipt-{{$timestamp}}@petcheck.com",
  "password": "test1234!",
  "nickname": "영수증테스터",
  "role": "CUSTOMER"
}

> {% client.global.set("email", response.body.email); %}

### 2. 로그인
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "test1234!" }

> {% client.global.set("token", response.body.accessToken); %}

### 3-1. 사장님 가입
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "owner-{{$timestamp}}@petcheck.com",
  "password": "test1234!",
  "nickname": "영수증매장사장",
  "role": "STORE"
}

> {% client.global.set("ownerEmail", response.body.email); %}

### 3-2. 사장님 로그인
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{ "email": "{{ownerEmail}}", "password": "test1234!" }

> {% client.global.set("ownerToken", response.body.accessToken); %}

### 3-3. 매장 등록 — 영수증 상호로 장소를 만들고 사장님을 연결
### 최초 1회만 newPlace 로 등록합니다.
### 두 번째 실행부터는 newPlace 블록을 지우고 "placeId": <1회차에서 만들어진 id> 로 바꾸세요.
### (장소가 남아 있어 같은 이름으로 다시 만들면 500m 이내 중복으로 막힙니다)
POST http://localhost:8080/api/store
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "businessNumber": "1993301802",
  "businessName": "차차 식당",
  "newPlace": {
    "name": "차차 식당",
    "category": "RESTAURANT",
    "address": "광주광역시 동구 충장로 1",
    "phone": "062-000-0000",
    "latitude": 35.1468,
    "longitude": 126.9227
  },
  "legalChecklist": {
    "partitioned": true,
    "cageProvided": true,
    "leashAnchor": true,
    "seatCover": true,
    "petTableware": true,
    "petWasteBin": true,
    "entranceSign": true,
    "vaccinationCheck": true
  },
  "petPolicy": {
    "allowSmall": true,
    "allowMedium": true,
    "allowLarge": false,
    "indoorAllowed": true
  }
}

> {%
    client.log("등록 응답 = " + JSON.stringify(response.body));

    client.test("매장 등록 성공", () => client.assert(response.status < 300));

    client.global.set("storeId", String(response.body.id));
    client.global.set("placeId", String(response.body.placeId));

    client.log("★ 이 placeId 를 적어두세요. 2회차부터 newPlace 대신 씁니다 → " + response.body.placeId);
%}

### 3-4. 관리자 로그인
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{ "email": "admin@petcheck.com", "password": "admin1234!" }

> {% client.global.set("adminToken", response.body.accessToken); %}

### 3-5. 매장 승인 — 승인돼야 사전 점수가 0.8 로 올라간다
POST http://localhost:8080/api/admin/stores/{{storeId}}/approve
Authorization: Bearer {{adminToken}}

> {% client.test("승인 성공", () => client.assert(response.status < 300)); %}

### 3. 기준 점수 기록
GET http://localhost:8080/api/places/{{placeId}}

> {%
    client.global.set("scoreBefore", String(response.body.trustScore));
    client.log("대상 장소 = " + response.body.name + " / 기준점수 " + response.body.trustScore);

    const d = new Date();
    const pad = (n) => String(n).padStart(2, "0");
    client.global.set("today", d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()));
%}

### 4. 영수증 사진 업로드
POST http://localhost:8080/api/reviews/images
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="receipt.jpg"
Content-Type: image/jpeg

< ./receipt.jpg
--WebAppBoundary--

> {%
    client.global.set("receiptUrl", response.body.url);
    client.log("업로드 경로 = " + response.body.url);
%}

### 5. 영수증을 붙여 리뷰 작성
POST http://localhost:8080/api/reviews
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "placeId": {{placeId}},
  "matched": true,
  "visitedAt": "{{today}}",
  "content": "영수증 첨부해서 남깁니다. 입구 안내문대로 소형견 동반 가능했고 목줄만 하면 됐어요.",
  "receiptImageUrl": "{{receiptUrl}}"
}

> {%
    client.global.set("reviewId", String(response.body.id));
    client.test("작성 직후에는 NONE", () =>
        client.assert(response.body.verificationLevel === "NONE"));
    client.log("작성 직후 가중치 = " + response.body.currentWeight);
%}

### 6. 영수증 판독과 진정성 판정이 끝나기를 기다린다
< {%
    const until = Date.now() + 12000;   // 멀티모달이라 텍스트 판정보다 오래 걸린다
    while (Date.now() < until) { }
%}
GET http://localhost:8080/api/health

### 7. ★ 인증 등급이 RECEIPT 로 올라갔는지
GET http://localhost:8080/api/reviews/me?size=5
Authorization: Bearer {{token}}

> {%
    const r = response.body.content.find((x) => String(x.id) === client.global.get("reviewId"));

    client.log("인증등급 = " + r.verificationLevel);
    client.log("진정성   = " + r.authenticityStatus);
    client.log("가중치   = " + r.currentWeight + "  (일반 리뷰는 0.25)");

    client.test("영수증 인증 성공", () => client.assert(r.verificationLevel === "RECEIPT"));
    client.test("가중치가 1.0 — 일반 리뷰의 네 배", () =>
        client.assert(Math.abs(r.currentWeight - 1.0) < 0.02));
%}

### 8. 장소 점수 변화
GET http://localhost:8080/api/places/{{placeId}}

> {%
    const before = parseFloat(client.global.get("scoreBefore"));
    client.log("작성 전 = " + before + " / 영수증 리뷰 후 = " + response.body.trustScore);
    client.test("점수 상승", () => client.assert(response.body.trustScore > before));
%}

### 9. 정리
DELETE http://localhost:8080/api/auth/me
Authorization: Bearer {{token}}

### 10. 정리 — 테스트 매장 삭제
DELETE http://localhost:8080/api/store/{{storeId}}
Authorization: Bearer {{ownerToken}}

### 11. 정리 — 사장님 탈퇴
DELETE http://localhost:8080/api/auth/me
Authorization: Bearer {{ownerToken}}