### =====================================================================
### 리뷰 Phase 1 검증 — 단독 실행 가능 (Run all requests in file)
### 핵심은 13~15번: 리뷰를 지웠을 때 trustScore 가 작성 전 값으로
### 소수점까지 정확히 되돌아오는지 확인한다.
### =====================================================================

### 1. 고객 A 가입
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "reviewer-a-{{$timestamp}}@petcheck.com",
  "password": "test1234!",
  "nickname": "리뷰어A",
  "role": "CUSTOMER"
}

> {%
    client.global.set("emailA", response.body.email);
    client.test("가입 성공", () => client.assert(response.status === 201 || response.status === 200));
%}

### 2. 고객 A 로그인
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "{{emailA}}",
  "password": "test1234!"
}

> {%
    client.global.set("tokenA", response.body.accessToken);
    client.test("토큰 발급", () => client.assert(response.body.accessToken !== undefined));
%}

### 3. 리뷰를 달 장소 하나 고르기
GET http://localhost:8080/api/places?size=1

> {%
    const place = response.body.content[0];
    client.global.set("placeId", place.id);
    client.log("대상 장소: " + place.name + " (id=" + place.id + ")");

    // 오늘 날짜를 yyyy-MM-dd 로 만들어 둔다.
    // toISOString() 은 UTC 라서 새벽에 돌리면 어제 날짜가 나온다 — 로컬 기준으로 직접 조립한다.
    const d = new Date();
    const pad = (n) => String(n).padStart(2, "0");
    client.global.set("today", d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()));
%}

### 4. 리뷰 작성 전 신뢰도 기록  ★ 기준값
GET http://localhost:8080/api/places/{{placeId}}

> {%
    client.global.set("scoreBefore", response.body.trustScore);
    client.global.set("countBefore", response.body.reviewCount);
    client.log("작성 전 trustScore = " + response.body.trustScore
        + " / reviewCount = " + response.body.reviewCount);
%}

### 5. 리뷰 작성 — 정보 일치, 오늘 방문
POST http://localhost:8080/api/reviews
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "placeId": {{placeId}},
  "matched": true,
  "visitedAt": "{{today}}",
  "content": "소형견 동반으로 방문했는데 안내된 대로 실내 입장 가능했습니다. 좌석 커버도 따로 제공해줘요."
}

> {%
    client.global.set("reviewId", response.body.id);
    client.test("201 생성", () => client.assert(response.status === 201));
    client.test("인증 등급이 판정됨", () => client.assert(response.body.verificationLevel !== null));
    client.log("인증등급=" + response.body.verificationLevel
        + " / 진정성=" + response.body.authenticityStatus
        + " / 현재 가중치=" + response.body.currentWeight);
%}

### 6. 같은 날 같은 장소 중복 작성 → 거부되어야 함
POST http://localhost:8080/api/reviews
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "placeId": {{placeId}},
  "matched": true,
  "visitedAt": "{{today}}",
  "content": "같은 날 두 번째 리뷰 시도"
}

> {%
    client.test("중복 작성 거부", () => client.assert(response.status !== 201));
    client.log("응답 코드=" + response.status + " / " + JSON.stringify(response.body));
%}

### 7. 신뢰도가 올라갔는지 확인
GET http://localhost:8080/api/places/{{placeId}}

> {%
    const before = parseFloat(client.global.get("scoreBefore"));
    client.global.set("scoreAfterCreate", response.body.trustScore);
    client.test("리뷰 수 +1", () =>
        client.assert(response.body.reviewCount === parseInt(client.global.get("countBefore")) + 1));
    client.test("점수 상승", () => client.assert(response.body.trustScore > before));
    client.log("작성 후 trustScore = " + response.body.trustScore + " (이전 " + before + ")");
%}

### 8. 리뷰 수정 — 불일치로 바꾸고 사유를 붙인다
PUT http://localhost:8080/api/reviews/{{reviewId}}
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "matched": false,
  "mismatchReasons": ["SIZE_LIMIT_DIFFERENT", "FEE_DIFFERENT"],
  "content": "다시 확인해보니 소형견만 가능하고 반려동물 추가요금 5000원이 따로 있었습니다."
}

> {%
    client.test("200 수정", () => client.assert(response.status === 200));
    client.test("불일치로 변경됨", () => client.assert(response.body.matched === false));
    client.test("본문 변경으로 진정성 재판정 대기", () =>
        client.assert(response.body.authenticityStatus === "PENDING"));
    client.log("수정 후 가중치=" + response.body.currentWeight);
%}

### 9. 불일치로 바뀌면서 점수가 내려갔는지 확인
GET http://localhost:8080/api/places/{{placeId}}

> {%
    const afterCreate = parseFloat(client.global.get("scoreAfterCreate"));
    client.test("불일치 반영으로 점수 하락", () => client.assert(response.body.trustScore < afterCreate));
    client.log("수정 후 trustScore = " + response.body.trustScore + " (일치였을 때 " + afterCreate + ")");
%}

### 10. 고객 B 가입 — 소유권 검사용
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "reviewer-b-{{$timestamp}}@petcheck.com",
  "password": "test1234!",
  "nickname": "리뷰어B",
  "role": "CUSTOMER"
}

> {% client.global.set("emailB", response.body.email); %}

### 11. 고객 B 로그인
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "{{emailB}}",
  "password": "test1234!"
}

> {% client.global.set("tokenB", response.body.accessToken); %}

### 12. B 가 A 의 리뷰를 수정 시도 → 거부
PUT http://localhost:8080/api/reviews/{{reviewId}}
Content-Type: application/json
Authorization: Bearer {{tokenB}}

{
  "matched": true,
  "content": "남의 리뷰를 고쳐본다"
}

> {%
    client.test("남의 리뷰 수정 불가", () => client.assert(response.status === 403));
%}

### 13. 토큰 없이 공개 목록 조회 → 200
GET http://localhost:8080/api/reviews?placeId={{placeId}}&size=10

> {%
    client.test("목록은 공개", () => client.assert(response.status === 200));
    client.log("리뷰 " + response.body.totalElements + "건");
%}

### 14. 토큰 없이 내 리뷰 조회 → 401
GET http://localhost:8080/api/reviews/me

> {%
    client.test("내 리뷰는 인증 필요", () => client.assert(response.status === 401));
%}

### 15. 리뷰 삭제
DELETE http://localhost:8080/api/reviews/{{reviewId}}
Authorization: Bearer {{tokenA}}

> {% client.test("204 삭제", () => client.assert(response.status === 204)); %}

### 16. ★ 핵심 검증 — 작성 전 값으로 정확히 복귀했는가
GET http://localhost:8080/api/places/{{placeId}}

> {%
    const before = parseFloat(client.global.get("scoreBefore"));
    const now = response.body.trustScore;
    const diff = Math.abs(now - before);

    client.log("작성 전 = " + before);
    client.log("삭제 후 = " + now);
    client.log("오차   = " + diff);

    client.test("리뷰 수 원복", () =>
        client.assert(response.body.reviewCount === parseInt(client.global.get("countBefore"))));
    client.test("신뢰도 원복 (오차 1e-9 이내)", () => client.assert(diff < 1e-9));
%}

### 17. 정리 — 고객 A 탈퇴
DELETE http://localhost:8080/api/auth/me
Authorization: Bearer {{tokenA}}

### 18. 정리 — 고객 B 탈퇴
DELETE http://localhost:8080/api/auth/me
Authorization: Bearer {{tokenB}}